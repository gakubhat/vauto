# V3 - Auto Board
# Copy to .env and fill in. Values below are placeholders or defaults.

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Admin dashboard (single office login) ───────────────────────────────
# The phone and password used at /api/admin/login and in the admin UI.
#
# JWT_SECRET signs the 12h admin session token. It is the ONLY thing protecting
# every rider's phone number, every driver's KYC document and Aadhaar number,
# and the full message history - anyone holding it can mint a valid admin token.
# Generate one, do not invent one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it logs out every existing admin session.
JWT_SECRET=generate-a-random-value-do-not-reuse-change-me
#
# ADMIN_PASSWORD is stored in plaintext and compared directly - see docs/admin.md.
ADMIN_PHONE=+919999000000
ADMIN_PASSWORD=change-me

# ── Supabase ────────────────────────────────────────────────────────────
# Service role key - backend only, never expose it to a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket for driver KYC documents (must be private, not public).
STORAGE_BUCKET_KYC=kyc

# ── WhatsApp Cloud API (one number for riders and drivers) ──────────────
# IMPORTANT: WHATSAPP_ACCESS_TOKEN must be a permanent token from a System
# User, not the 24-hour temporary one from the App Dashboard.
#   business.facebook.com -> Business settings -> Users -> System users
#   -> Add assets (WhatsApp app) -> Generate new token
# Verify any time with:  cd server && npm run check:whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_PHONE=+919999000000

# App secret, from Meta App Dashboard -> Settings -> Basic -> App secret.
# Every webhook POST is verified against X-Hub-Signature-256 using this. If it
# is wrong or missing the app rejects ALL inbound messages, so set it with care
# and test with:  cd server && npm run check:whatsapp
WHATSAPP_APP_SECRET=your-meta-app-secret

# Pinned Graph API version. Check expiry at
# developers.facebook.com/docs/graph-api/changelog/versions
WHATSAPP_API_VERSION=v25.0

# ── Defaults (all optional, these are the built-in values) ──────────────
DEFAULT_RADIUS_KM=3
TRIP_OTP_TTL_SECONDS=3600

# Tests truncate real tables. Required for `npm test` and `npm run sim --fresh`.
ALLOW_DESTRUCTIVE_TESTS=true

# Enables delete-user in the admin UI (DELETE /admin/riders|drivers/:id).
# Off by default - deletion is irreversible and removes KYC documents.
ALLOW_ADMIN_DELETE=false

# Lets the office number (settings.office_number) use the bot as a rider, so
# screenshots and demos can be captured from the WhatsApp Business app.
#
# Keep this OFF. It is off by default because with it on, the office cannot
# reply to its own alerts - every such reply is read as a customer message and
# starts a rider signup with our own staff.
ALLOW_OFFICE_AS_USER=false
