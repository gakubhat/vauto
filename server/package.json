{
  "name": "v3-auto-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/dev/simulate.ts",
    "tunnel": "bash ../scripts/tunnel.sh",
    "check:whatsapp": "tsx src/dev/check-token.ts",
    "check:kyc": "tsx src/dev/check-kyc.ts",
    "db-reset": "echo 'use MCP apply_migration or Supabase SQL editor with supabase/schema.sql'",
    "check:docs": "vitest run tests/docs.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
